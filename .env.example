# Local migration/build configuration. Never commit a real .env file.
TURSO_DATABASE_URL=libsql://your-database-your-org.turso.io
TURSO_AUTH_TOKEN=replace-with-your-turso-token
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
ADMIN_USER=your-admin-username
ADMIN_PASS=use-a-strong-unique-admin-password
# Optional aliases if you already use these names instead:
# ADMIN_USERNAME=your-admin-username
# ADMIN_PASSWORD=use-a-strong-unique-admin-password
# Exact deployed origin(s), comma-separated. Example: https://easybill-yourname.vercel.app
ALLOWED_ORIGINS=
# Public support contact numbers, digits only with country code (India: 91...)
EB_OWNER_PHONE=
EB_OWNER_WHATSAPP=
